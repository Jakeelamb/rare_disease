        """


rule prior_normalized_vcf:
    input:
        vcf=source_vcf,
        tbi=f"{source_vcf}.tbi",
        reference=config["references"]["alignment_fasta"],
        fai=f"{config['references']['alignment_fasta']}.fai",
    output:
        vcf=f"{private_root}/variants/mva_prior.normalized.vcf.gz",
        tbi=f"{private_root}/variants/mva_prior.normalized.vcf.gz.tbi",
    params:
        regions=prior_regions,
    threads: config["threads"]["bcftools"]
    log:
        f"{private_root}/logs/prior_normalize.log",
    shell:
        """
        bcftools view --threads {threads} --apply-filters PASS \
          --regions {params.regions:q} --output-type u {input.vcf:q} 2>> {log:q} \
        | bcftools norm --threads {threads} --multiallelics -any \
          --fasta-ref {input.reference:q} --output-type z --output {output.vcf:q} 2>> {log:q}
        bcftools index --force --threads {threads} --tbi {output.vcf:q} 2>> {log:q}
        """


rule annotate_prior_vep:
    input:
        vcf=f"{private_root}/variants/mva_prior.normalized.vcf.gz",
        tbi=f"{private_root}/variants/mva_prior.normalized.vcf.gz.tbi",
        cache="resources/vep/homo_sapiens/116_GRCh38/info.txt",
        reference=config["references"]["alignment_fasta"],
        fai=f"{config['references']['alignment_fasta']}.fai",
        alphamissense=config["references"]["alphamissense"],
        alphamissense_tbi=f"{config['references']['alphamissense']}.tbi",
    output:
        vcf=f"{private_root}/variants/mva_prior.vep.vcf.gz",
        tbi=f"{private_root}/variants/mva_prior.vep.vcf.gz.tbi",
    threads: config["threads"]["vep"]
    log:
        f"{private_root}/logs/prior_vep.log",
    params:
        cache=lambda wildcards, input: str(Path(input.cache).parents[2]),
        perl=str(vep_bin / "perl"),
        vep=str(vep_bin / "vep"),
        bgzip=str(vep_bin / "bgzip"),
        tabix=str(vep_bin / "tabix"),
        plugin_dir=str(vep_plugin_dir),
    shell:
        """
        {params.perl:q} {params.vep:q} --input_file {input.vcf:q} --output_file STDOUT \
          --format vcf --vcf --offline --cache --cache_version 116 --assembly GRCh38 \
          --dir_cache {params.cache:q} --fasta {input.reference:q} \
          --dir_plugins {params.plugin_dir:q} \
          --plugin AlphaMissense,file={input.alphamissense:q} \
          --symbol --canonical --mane --biotype --hgvs --sift b --polyphen b \
          --variant_class --numbers --af_gnomade --af_gnomadg --no_stats \
          --force_overwrite --fork {threads} 2> {log:q} \
        | {params.bgzip:q} --threads {threads} > {output.vcf:q}
        {params.tabix:q} --force --preset vcf {output.vcf:q}
        """


