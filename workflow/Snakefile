rule query_leading_candidate_clinvar:
    input:
        ranked=f"{private_root}/ranking/mva_prior.ranked.json",
        archive=config["references"]["clinvar_archive"],
        code="src/mva_hackathon/adjudication.py",
    output:
        f"{private_root}/wgs/adjudication/leading_candidate.clinvar.json",
    log:
        f"{private_root}/logs/leading_candidate_clinvar.log",
    params:
        release=config["references"]["clinvar_release"],
    shell:
        """
        mva query-candidate-clinvar {input.ranked:q} --archive {input.archive:q} \
          --release {params.release:q} --hypothesis-limit 3 --output {output:q} > {log:q}
        """


rule adjudicate_leading_candidate:
    input:
        focused=f"{private_root}/ranking/mva_prior.ranked.json",
        agnostic=f"{private_root}/ranking/agnostic_coding.ranked.json",
        deepvariant=f"{private_root}/wgs/ranking/deepvariant_coding.ranked.json",
        recall_vcf=f"{private_root}/wgs/deepvariant/PROBAND01.phased.vcf.gz",
        recall_tbi=f"{private_root}/wgs/deepvariant/PROBAND01.phased.vcf.gz.tbi",
        reads=f"{private_root}/wgs/qc/leading_candidate_reads.json",
        clinvar=f"{private_root}/wgs/adjudication/leading_candidate.clinvar.json",
        code="src/mva_hackathon/adjudication.py",
    output:
        json=f"{private_root}/wgs/adjudication/leading_candidate.json",
        review=f"{private_root}/wgs/adjudication/leading_candidate.review.md",
    log:
        f"{private_root}/logs/leading_candidate_adjudication.log",
    shell:
        """
        mva adjudicate-leading {input.focused:q} \
          --ranking focused={input.focused:q} \
          --ranking agnostic={input.agnostic:q} \
          --ranking deepvariant={input.deepvariant:q} \
          --recall-vcf {input.recall_vcf:q} --read-audit {input.reads:q} \
          --clinvar {input.clinvar:q} --json-output {output.json:q} \
          --review-output {output.review:q} > {log:q}
        """
