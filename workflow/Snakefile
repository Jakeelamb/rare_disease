    input:
        f"{private_root}/wgs/smoke/wgs_tool_smoke.json",


include: "wgs.smk"


rule gzip_integrity:
    input:
        source_vcf,
        fastqs,
    output:
        touch(f"{private_root}/qc/gzip_integrity.valid"),
    threads: 12
    log:
        f"{private_root}/logs/gzip_integrity.log",
    shell:
        "pigz --test --processes {threads} {input:q} 2> {log:q}"


rule fastp_lane_qc:
    input:
        r1=lambda wildcards: read_pairs[wildcards.lane][0],
        r2=lambda wildcards: read_pairs[wildcards.lane][1],
    output:
        json=f"{private_root}/qc/fastp/{{lane}}.fastp.json",
        html=f"{private_root}/qc/fastp/{{lane}}.fastp.html",
    threads: 8
    log:
        f"{private_root}/logs/fastp_{{lane}}.log",
    shell:
        """
        fastp --in1 {input.r1:q} --in2 {input.r2:q} \
          --stdout --detect_adapter_for_pe \
          --thread {threads} --json {output.json:q} --html {output.html:q} \
          > /dev/null 2> {log:q}
        """


rule multiqc:
    input:
        fastp_jsons,
    output:
        f"{private_root}/qc/multiqc/multiqc_report.html",
    log:
        f"{private_root}/logs/multiqc.log",
    params:
        outdir=lambda wildcards, output: str(Path(output[0]).parent),
        source=lambda wildcards, input: str(Path(input[0]).parent),
    shell:
        """
        multiqc --force --outdir {params.outdir:q} \
          --filename multiqc_report.html {params.source:q} > {log:q} 2>&1
        """


