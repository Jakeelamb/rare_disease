"""Fast, inspectable rare-disease research workflow.

Each aggregate target is independently runnable. Snakemake records what ran;
researchers inspect the private artifacts, change assumptions, and rerun.
"""

import re
from pathlib import Path

import yaml


configfile: "config/workflow.yaml"


def single_or_placeholder(pattern, placeholder, label):
    matches = sorted(str(path) for path in Path(".").glob(pattern))
    if len(matches) > 1:
        raise WorkflowError(f"{label} glob matched multiple files: {matches}")
    return matches[0] if matches else placeholder


def discover_read_pairs(pattern):
    fastq_paths = sorted(str(path) for path in Path(".").glob(pattern))
    pairs = {}
    for index, r1 in enumerate(path for path in fastq_paths if "_R1_" in path):
        r2 = r1.replace("_R1_", "_R2_")
        if r2 not in fastq_paths:
            raise WorkflowError(f"missing R2 mate for {r1}")
        match = re.search(r"(L\d{3})", Path(r1).name)
        lane = match.group(1) if match else f"L{index + 1:03d}"
        pairs[lane] = (r1, r2)
    return pairs


with Path(config["references"]["mechanism_priors"]).open(encoding="utf-8") as handle:
    disease_priors = yaml.safe_load(handle)

prior_regions = ",".join(gene["region"] for gene in disease_priors["genes"])
private_root = config["outputs"]["private_root"]
source_vcf = single_or_placeholder(
    config["inputs"]["vcf_glob"], config["inputs"]["vcf_placeholder"], "VCF"
)
phenotype_docx = single_or_placeholder(
    config["inputs"]["phenotype_glob"],
    config["inputs"]["phenotype_placeholder"],
    "phenotype",
)
read_pairs = discover_read_pairs(config["inputs"]["fastq_glob"])
lanes = sorted(read_pairs)
fastqs = [path for lane in lanes for path in read_pairs[lane]]
fastp_jsons = expand(f"{private_root}/qc/fastp/{{lane}}.fastp.json", lane=lanes)
phenotype_priors = f"{private_root}/evidence/phenotype_gene_priors.yaml"
pixi_env_root = Path(config["pixi"]["environment_root"])
vep_bin = pixi_env_root / "vep" / "bin"
vep_plugin_dir = pixi_env_root / "vep" / "share" / "ensembl-vep-116.1-0"
wgs_bin = pixi_env_root / "wgs" / "bin"
phasing_bin = pixi_env_root / "phasing" / "bin"

rule intake:
    input:
        f"{private_root}/qc/gzip_integrity.valid",
        f"{private_root}/qc/multiqc/multiqc_report.html",
        f"{private_root}/qc/vcf_summary.json",


rule phenotype_extraction:
    input:
        f"{private_root}/phenotype/phenotype.json",
        f"{private_root}/phenotype/phenotype.review.md",


rule phenotype_scoring:
    input:
        f"{private_root}/phenotype/phenotype.curated.json",
        phenotype_priors,


rule small_variant:
    input:
        f"{private_root}/ranking/mva_prior.review.md",
        f"{private_root}/ranking/agnostic_coding.review.md",
        f"{private_root}/ranking/small_variant.lane_comparison.md",


rule benchmark:
    input:
        f"{private_root}/benchmark/baseline.metrics.json",
        f"{private_root}/benchmark/candidate.metrics.json",
        f"{private_root}/benchmark/union.metrics.json",
        f"{private_root}/benchmark/tool_comparison.json",


